
# Application
NODE_ENV=development
PORT=8080
COMPANY_START_DATE=2026-01-01
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://orgingraphs-ysq7.vercel.app

# FalkorDB Cloud
FALKORDB_HOST=your-falkordb-cloud-host
FALKORDB_PORT=52330
FALKORDB_USERNAME=your-falkordb-username
FALKORDB_PASSWORD=your-falkordb-password
FALKORDB_TLS=false
FALKORDB_DATABASE=orgingraphs
FALKORDB_GRAPH=
CONFLUENCE_INGESTION_ENABLED=true
CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_EMAIL=your-account@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_API_KEY=
# Provider API keys are credentials; put connector URLs in MOCK_API_BASE_URL.
# The bundled route-catalog service contains fixtures and is rejected by ingestion.
JIRA_API_KEY=
GITHUB_API_KEY=
SLACK_API_KEY=
MOCK_API_BASE_URL=http://localhost:8787

# Optional model instances. Gemini credentials stay on the backend.
# Bedrock Mantle answers use the OpenAI-compatible chat completions endpoint.
MODEL_PROVIDER=disabled
# Keep this key on the backend only. Never set it in a NEXT_PUBLIC_* variable.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MODEL=openai.gpt-oss-120b
BEDROCK_MAX_TOKENS=1000
BEDROCK_TEMPERATURE=0.2
BEDROCK_TIMEOUT_MS=45000
# Required to authorize RAG ingestion and re-index operations.
RAG_ADMIN_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=your-model-api-key
MODEL_DEFAULT_ID=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MODEL_TICKET_ID=
MODEL_FEATURE_UPDATE_ID=
MODEL_DEFAULT_TEMPERATURE=0
MODEL_TICKET_TEMPERATURE=
MODEL_FEATURE_UPDATE_TEMPERATURE=
MODEL_TIMEOUT_MS=15000

# Agent 1: Organization Intelligence & RAG
RAG_EMBEDDING_PROVIDER=local
RAG_CHUNK_MAX_CHARS=2000
RAG_CHUNK_OVERLAP_CHARS=300
RAG_CONTEXT_MAX_CHARS=16000
RAG_AUTO_SYNC_ENABLED=true
RAG_SYNC_POLL_INTERVAL_MS=60000
RAG_SYNC_BATCH_SIZE=25
RAG_SYNC_CONCURRENCY=4
RAG_SYNC_MAX_RETRIES=5
# Used only by local development/tests when no FalkorDB Graph is supplied.
VECTOR_STORE_PATH=./data/vector-store.json
ORGANIZATION_ID=hirenova
