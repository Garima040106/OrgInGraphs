{
  "name": "orgingraphs",
  "version": "1.0.0",
  "description": "Backend foundation for OrgInGraphs, an AI-powered company knowledge graph.",
  "private": true,
  "author": "Garima and Nikhil",
  "contributors": [
    "Garima",
    "Nikhil"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "rag:rebuild": "tsx scripts/rebuild-rag.ts",
    "rag:verify": "tsx scripts/verify-rag.ts",
    "start": "node dist/index.js",
    "seed:generate": "tsx scripts/seed-generate.ts",
    "seed:validate": "tsx scripts/seed-validate.ts",
    "seed:falkordb": "tsx scripts/seed-falkordb.ts",
    "product:seed:generate": "tsx scripts/product-seed-generate.ts",
    "product:seed:validate": "tsx scripts/product-seed-validate.ts",
    "product:seed:falkordb": "tsx scripts/product-seed-falkordb.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@langchain/langgraph": "^1.5.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "falkordb": "^6.8.0",
    "openai": "^7.38.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
